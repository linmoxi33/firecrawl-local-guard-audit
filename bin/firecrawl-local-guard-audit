#!/usr/bin/env python3
"""Offline auditor for Firecrawl Local's private-network guard.

Replicates apps/local/src/guard.rs (URL layer + IP classifier) and triages
saved /v2/scrape responses for refusals reported as successes.
Zero dependencies, no network.
"""
import argparse
import ipaddress
import json
import os
import sys
from urllib.parse import urlsplit

VERSION = "1.0.0"

# --- guard.rs port -----------------------------------------------------------

def v4_is_metadata_or_link_local(ip):
    # 169.254.0.0/16 plus Alibaba Cloud metadata 100.100.100.200
    return ip.is_link_local or ip == ipaddress.IPv4Address("100.100.100.200")


_DOC_V4 = (
    ipaddress.IPv4Network("192.0.2.0/24"),
    ipaddress.IPv4Network("198.51.100.0/24"),
    ipaddress.IPv4Network("203.0.113.0/24"),
)


def v4_is_private(ip):
    o = ip.packed
    return (
        ip.is_loopback
        or ip.is_private
        or ip.is_unspecified
        or ip == ipaddress.IPv4Address("255.255.255.255")
        or ip.is_multicast
        or any(ip in net for net in _DOC_V4)
        or (o[0] == 100 and (o[1] & 0b1100_0000) == 64)      # 100.64.0.0/10 CGNAT
        or (o[0] == 192 and o[1] == 0 and o[2] == 0)          # 192.0.0.0/24
        or (o[0] == 198 and (o[1] & 0xFE) == 18)              # 198.18.0.0/15
        or o[0] >= 240                                        # 240.0.0.0/4
        or o[0] == 0                                          # 0.0.0.0/8
    )


def v6_embedded_v4(ip):
    mapped = ip.ipv4_mapped
    if mapped is not None:
        return mapped
    s = ip.exploded
    seg = [int(x, 16) for x in s.split(":")]
    if (seg[0] == 0x64 and seg[1] == 0xFF9B and all(x == 0 for x in seg[2:6])) or (
        all(x == 0 for x in seg[:6]) and (seg[6] != 0 or seg[7] > 1)
    ):
        return ipaddress.IPv4Address(bytes([
            (seg[6] >> 8) & 0xFF, seg[6] & 0xFF, (seg[7] >> 8) & 0xFF, seg[7] & 0xFF
        ]))
    return None


def v6_is_link_local(ip):
    return (int(ip) >> 118) == 0b1111111010  # fe80::/10


def v6_is_private(ip):
    first = int(ip) >> 112
    return (
        ip.is_loopback
        or ip.is_unspecified
        or ip.is_multicast
        or (first & 0xFE00) == 0xFC00   # fc00::/7
        or (first & 0xFFC0) == 0xFEC0   # fec0::/10
        or (first == 0x2001 and (int(ip) >> 96) & 0xFFFF == 0x0DB8)  # 2001:db8::/32
    )


def ip_always_blocked(ip):
    if isinstance(ip, ipaddress.IPv4Address):
        return v4_is_metadata_or_link_local(ip)
    emb = v6_embedded_v4(ip)
    if emb is not None:
        return v4_is_metadata_or_link_local(emb)
    return v6_is_link_local(ip)


def ip_is_private(ip):
    if isinstance(ip, ipaddress.IPv4Address):
        return v4_is_private(ip) or v4_is_metadata_or_link_local(ip)
    emb = v6_embedded_v4(ip)
    if emb is not None:
        return v4_is_private(emb) or v4_is_metadata_or_link_local(emb)
    return v6_is_private(ip) or v6_is_link_local(ip)


def check_ip(ip, policy):
    if ip_always_blocked(ip):
        return "blocked", "ALWAYS_BLOCKED", f"{ip} is a link-local or metadata address and is never reachable"
    if policy == "public-only" and ip_is_private(ip):
        return "blocked", "PRIVATE_ADDRESS", f"{ip} is a private address; private targets are off"
    return "ok", None, None


STATIC_LOCAL_SUFFIXES = (".localhost", ".local", ".internal")


def hostname_is_local(host):
    h = host.rstrip(".").lower()
    return (
        h == "localhost"
        or h.endswith(STATIC_LOCAL_SUFFIXES)
        or h == "metadata"
        or h == "metadata.google.internal"
    )


def classify_url(url, policy):
    """Return dict describing the guard's decision, without DNS."""
    rec = {"url": url, "verdict": None, "rule": None, "reason": None,
           "dns_gate_only": False, "host": None}
    try:
        parts = urlsplit(url)
    except ValueError as exc:
        rec.update(verdict="blocked", rule="MALFORMED_URL", reason=str(exc))
        return rec
    if parts.scheme not in ("http", "https"):
        rec.update(verdict="blocked", rule="UNSUPPORTED_SCHEME",
                   reason=f"unsupported URL scheme '{parts.scheme}': only http and https are fetched")
        return rec
    if parts.username or parts.password:
        rec.update(verdict="blocked", rule="EMBEDDED_CREDENTIALS",
                   reason="URLs with embedded credentials are not fetched")
        return rec
    host = parts.hostname
    if not host:
        rec.update(verdict="blocked", rule="NO_HOST", reason="URL has no host")
        return rec
    rec["host"] = host

    literal = None
    try:
        literal = ipaddress.ip_address(host)
    except ValueError:
        literal = None

    if literal is not None:
        verdict, rule, reason = check_ip(literal, policy)
        rec.update(verdict=verdict, rule=rule, reason=reason)
        return rec

    if policy == "public-only" and hostname_is_local(host):
        rec.update(verdict="blocked", rule="LOCAL_HOSTNAME",
                   reason=f"'{host}' is a local hostname; private targets are off")
        return rec
    if host.lower() == "metadata.google.internal":
        rec.update(verdict="blocked", rule="METADATA_ENDPOINT",
                   reason="cloud metadata endpoints are never reachable")
        return rec

    # guard.rs returns Ok(()) here: the only remaining defence is GuardedResolver.
    rec.update(verdict="ok", rule="DNS_RESOLVER_ONLY", dns_gate_only=True,
               reason="URL layer passes; refusal depends on DNS answers at connect time")
    return rec


PROXY_VARS = ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy")


def detect_proxy(extra):
    hits = sorted({v for v in PROXY_VARS if os.environ.get(v)}) + sorted(set(extra))
    return sorted(set(hits))


def audit_targets(lines, policy, proxy_vars):
    findings, records = [], []
    for lineno, raw in enumerate(lines, 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        rec = classify_url(line, policy)
        rec["line"] = lineno
        if rec["verdict"] == "blocked":
            findings.append({
                "id": "REFUSED_STATIC", "severity": "warning", "line": lineno,
                "url": rec["url"], "rule": rec["rule"], "reason": rec["reason"],
            })
        elif rec["dns_gate_only"] and proxy_vars:
            rec["proxy_bypass_risk"] = True
            findings.append({
                "id": "PROXY_BYPASS_RISK", "severity": "error", "line": lineno,
                "url": rec["url"], "rule": "DNS_RESOLVER_ONLY",
                "reason": "hostname is only checked by GuardedResolver, and a proxy variable is set; "
                          "reqwest resolves the proxy instead of the target (see issue #5942)",
            })
        else:
            findings.append({
                "id": "DNS_GATE_ONLY", "severity": "info", "line": lineno,
                "url": rec["url"], "rule": "DNS_RESOLVER_ONLY",
                "reason": "passes the URL layer; safety depends on DNS answers at connect time",
            })
        records.append(rec)
    summary = {
        "targets": len(records),
        "blocked": sum(1 for r in records if r["verdict"] == "blocked"),
        "dns_gate_only": sum(1 for r in records if r["dns_gate_only"]),
        "proxy_bypass_risk": sum(1 for f in findings if f["id"] == "PROXY_BYPASS_RISK"),
    }
    return {"mode": "targets", "policy": policy, "proxy_vars": proxy_vars,
            "summary": summary, "findings": findings, "records": records}


def _iter_responses(payload):
    if isinstance(payload, list):
        for i, item in enumerate(payload):
            yield i, item
    elif isinstance(payload, dict):
        if "data" in payload or "success" in payload:
            yield 0, payload
        else:
            for key in sorted(payload):
                yield key, payload[key]
    else:
        raise ValueError("response file must contain an object or a list")


def audit_responses(files):
    findings, records = [], []
    for path in files:
        with open(path, "r", encoding="utf-8") as fh:
            try:
                payload = json.load(fh)
            except json.JSONDecodeError as exc:
                raise ValueError(f"{path}: invalid JSON ({exc})")
        for idx, resp in _iter_responses(payload):
            if not isinstance(resp, dict):
                continue
            data = resp.get("data") if isinstance(resp.get("data"), dict) else {}
            meta = data.get("metadata") if isinstance(data.get("metadata"), dict) else {}
            success = resp.get("success")
            status = meta.get("statusCode")
            err = str(meta.get("error") or resp.get("error") or "")
            content = data.get("markdown") if data.get("markdown") is not None else data.get("html")
            rec = {"file": path, "index": idx, "success": success,
                   "status_code": status, "has_content": bool(content), "error": err[:200]}
            if success is True and status == 403 and "Blocked insecure target URL" in err:
                findings.append({"id": "MISREPORTED_REFUSAL", "severity": "error",
                                 "file": path, "index": idx,
                                 "reason": "refusal returned as a successful scrape (success:true, "
                                           "metadata.statusCode:403); clients that trust success see an empty success"})
            elif success is True and isinstance(status, int) and status >= 400 and not content:
                findings.append({"id": "SUCCESS_WITHOUT_CONTENT", "severity": "warning",
                                 "file": path, "index": idx,
                                 "reason": f"success:true with HTTP {status} and no content"})
            elif success is False and ("insecure" in err.lower() or "blocked" in err.lower()):
                findings.append({"id": "REFUSAL_REPORTED", "severity": "info",
                                 "file": path, "index": idx,
                                 "reason": "refusal surfaced as a failed scrape"})
            records.append(rec)
    summary = {"responses": len(records),
               "misreported_refusals": sum(1 for f in findings if f["id"] == "MISREPORTED_REFUSAL"),
               "success_without_content": sum(1 for f in findings if f["id"] == "SUCCESS_WITHOUT_CONTENT")}
    return {"mode": "responses", "summary": summary, "findings": findings, "records": records}


def has_blocking(report):
    return any(f["severity"] in ("error", "warning") for f in report["findings"])


def render_text(report):
    out = []
    s = report["summary"]
    if report["mode"] == "targets":
        out.append(f"policy={report['policy']} targets={s['targets']} blocked={s['blocked']} "
                   f"dns_gate_only={s['dns_gate_only']} proxy_bypass_risk={s['proxy_bypass_risk']}")
        if report["proxy_vars"]:
            out.append("proxy vars: " + ", ".join(report["proxy_vars"]))
        for f in report["findings"]:
            out.append(f"[{f['severity']}] {f['id']} line {f['line']}: {f['url']} ({f['rule']})")
    else:
        out.append(f"responses={s['responses']} misreported_refusals={s['misreported_refusals']} "
                   f"success_without_content={s['success_without_content']}")
        for f in report["findings"]:
            out.append(f"[{f['severity']}] {f['id']} {f['file']}#{f['index']}: {f['reason']}")
    return "\n".join(out) + "\n"


def emit(report, args):
    if args.out:
        with open(args.out, "w", encoding="utf-8") as fh:
            json.dump(report, fh, indent=2, sort_keys=True)
            fh.write("\n")
    if args.json:
        json.dump(report, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(render_text(report))
    return 1 if has_blocking(report) else 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="firecrawl-local-guard-audit",
                                description="Offline auditor for Firecrawl Local's private-network guard")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    t = sub.add_parser("targets", help="classify target URLs without DNS")
    t.add_argument("file")
    t.add_argument("--policy", choices=("public-only", "allow-private"), default="public-only")
    t.add_argument("--proxy-var", action="append", default=[], metavar="NAME",
                   help="treat this proxy variable as set (repeatable)")
    t.add_argument("--json", action="store_true")
    t.add_argument("--out")

    r = sub.add_parser("responses", help="triage saved /v2/scrape responses")
    r.add_argument("files", nargs="+")
    r.add_argument("--json", action="store_true")
    r.add_argument("--out")

    args = p.parse_args(argv)
    try:
        if args.cmd == "targets":
            if not os.path.isfile(args.file):
                sys.stderr.write(f"error: no such file: {args.file}\n")
                return 2
            with open(args.file, "r", encoding="utf-8") as fh:
                lines = fh.readlines()
            report = audit_targets(lines, args.policy, detect_proxy(args.proxy_var))
        else:
            for path in args.files:
                if not os.path.isfile(path):
                    sys.stderr.write(f"error: no such file: {path}\n")
                    return 2
            report = audit_responses(args.files)
    except (ValueError, OSError) as exc:
        sys.stderr.write(f"error: {exc}\n")
        return 2
    return emit(report, args)


if __name__ == "__main__":
    sys.exit(main())
